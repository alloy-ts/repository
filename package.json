{
  "name": "repository",
  "version": "0.1.0",
  "description": "Versioned repository for yumin-chen projects.",
  "keywords": [
    "git",
    "repository",
    "scm",
    "version-control"
  ],
  "license": "Unlicense",
  "author": "Yumin Chen",
  "repository": {
    "type": "git",
    "url": "git+https://repo.chen.software/yumin-chen/repository.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --import @oxc-node/core/register build.ts && vp pack",
    "dev": "vp pack --watch",
    "start": "vp run dist/index.js",
    "test": "vp test",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepublishOnly": "npm run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/cli": "^3.10.8",
    "@oxc-node/core": "^0.1.7",
    "@types/node": "^26.6.5",
    "emnapi": "^1.11.3",
    "vite-plus": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "napi": {
    "binaryName": "repository",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-unknown-freebsd",
      "wasm32-wasip1-threads"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0",
      "onFail": "download"
    }
  }
}
